# Aucun accès extérieur en mode démo. Écoute sur 127.0.0.1.
TRAVAUX_MODE=demo
TRAVAUX_DB=data/travaux.sqlite3
TRAVAUX_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Avant installation institutionnelle : mode=pilot, HTTPS, mot de passe haché,
# validation DSI/DPO et contrats. Voir docs/exploitation.md.
# TRAVAUX_PASSWORD_HASH=scrypt$...
# TRAVAUX_TENANT=mairie-pilote
# TRAVAUX_PUBLIC_ORIGIN=https://travaux.example
# TRAVAUX_ALLOWED_HOSTS=travaux.example
# Code d’adhésion d’une organisation réelle, à injecter côté serveur.
# Vide par défaut : aucune nouvelle demande par code n’est alors acceptée.
# TRAVAUX_ORGANIZATION_JOIN_CODE=code-partage-avec-les-futurs-membres
# LLM : demo ou mistral. Pas de repli silencieux.
TRAVAUX_LLM=demo
# TRAVAUX_MISTRAL_URL=https://endpoint-autorise.example/v1/chat/completions
# TRAVAUX_MISTRAL_MODEL=identifiant-modele-valide
# TRAVAUX_MISTRAL_KEY=secret-injecte-au-serveur
# Autorisation explicite de sortie, même pour un endpoint local :
# TRAVAUX_LLM_EGRESS_APPROVED=true
# AppFlowy : installation et manifeste validés séparément.
# TRAVAUX_APPFLOWY_URL=https://appflowy.example
# TRAVAUX_APPFLOWY_CONFIG=data/appflowy.json
# TRAVAUX_APPFLOWY_TOKEN=jeton-oauth-workspace-provisionne
