# Only these owned virtual hosts. Official Cloudflare IP lists checked 2026-11-17.
identite.kerforge.com {
  log {
    output discard
  }
  @cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  @publicIdentity path /realms/mayortech/* /resources/*
  route {
    request_header X-MayorTech-Client-IP {remote_host}
    request_header @cloudflare X-MayorTech-Client-IP {header.CF-Connecting-IP}
    handle @publicIdentity {
      reverse_proxy mayortech-identity-guard:8080 {
        header_up X-MayorTech-Client-IP {header.X-MayorTech-Client-IP}
        header_up X-Forwarded-For {header.X-MayorTech-Client-IP}
        header_up Host identite.kerforge.com
        header_up X-Forwarded-Host identite.kerforge.com
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
      }
    }
    handle {
      respond "Not found" 404
    }
  }
  handle_errors {
    respond "Service temporairement indisponible" 503
  }
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    -Server
  }
}
espace.kerforge.com {
  log {
    output discard
  }
  @cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
  route {
    request_header X-MayorTech-Client-IP {remote_host}
    request_header @cloudflare X-MayorTech-Client-IP {header.CF-Connecting-IP}
    reverse_proxy mayortech-private-app:8765 {
      header_up X-Forwarded-For {header.X-MayorTech-Client-IP}
      header_up X-Forwarded-Proto https
      header_up X-Forwarded-Host espace.kerforge.com
      header_up X-Forwarded-Port 443
    }
  }
  handle_errors {
    respond "Service temporairement indisponible" 503
  }
  header {
    Referrer-Policy no-referrer
    X-Content-Type-Options nosniff
    -Server
  }
}
