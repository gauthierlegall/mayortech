# EXEMPLE INERTE, SANS SECRET. Non charge automatiquement.
# Organisation fictive distincte du public et du futur espace municipal.
# La connexion reste indisponible tant que l'IdP n'est pas configure/approuve.
TRAVAUX_MODE=staging
TRAVAUX_AUTH_MODE=oidc
TRAVAUX_DB=/srv/travaux-test/data/travaux.sqlite3
TRAVAUX_TENANT=organization-test
TRAVAUX_PUBLIC_ORIGIN=https://travaux-test.commune.example
TRAVAUX_ALLOWED_HOSTS=travaux-test.commune.example
TRAVAUX_TEST_ORGANIZATION_SELF_JOIN=true
TRAVAUX_LLM=demo
TRAVAUX_LLM_EGRESS_APPROVED=false

# Seul l'IdP de recette sera autorise explicitement, apres configuration HTTPS.
# Les secrets restent dans le gestionnaire serveur, jamais dans cet exemple.
TRAVAUX_OIDC_EGRESS_APPROVED=false
TRAVAUX_OIDC_ISSUER=https://identite-test.commune.example/realms/travaux-test
TRAVAUX_OIDC_CLIENT_ID=travaux-test
TRAVAUX_OIDC_CLIENT_SECRET=
TRAVAUX_OIDC_ALLOWED_HOSTS=identite-test.commune.example
TRAVAUX_OIDC_PRIVATE_HOSTS=
# Exemple Keycloak seulement : doit correspondre aux vraies executions MFA.
TRAVAUX_OIDC_REQUIRED_AMR=pwd,otp
TRAVAUX_OIDC_REQUIRED_ACR=
TRAVAUX_OIDC_SIGNUP_URL=https://identite-test.commune.example/realms/travaux-test/protocol/openid-connect/registrations
TRAVAUX_CONNECTOR_KEY_FILE=/run/secrets/travaux-test-vault.keys

# Aucun mail, agenda ou fournisseur IA externe dans l'organisation test.
TRAVAUX_CONNECTOR_EGRESS_APPROVED=false
TRAVAUX_CONNECTOR_ALLOWED_HOSTS=
TRAVAUX_CONNECTOR_PRIVATE_HOSTS=
TRAVAUX_CONNECTOR_ALLOWED_PORTS=443
