# EXEMPLE INERTE, SANS SECRET. Ne pas demarrer tel quel.
# Candidat OVH prive APRES validation DSI ; aucun serveur n'est provisionne.
# Refus de demarrage attendu : sortie IA non approuvee et secrets absents.
TRAVAUX_MODE=pilot
TRAVAUX_AUTH_MODE=oidc
TRAVAUX_DB=/srv/travaux-prive/data/travaux.sqlite3
TRAVAUX_TENANT=commune-privee
TRAVAUX_PUBLIC_ORIGIN=https://travaux.commune.example
TRAVAUX_ALLOWED_HOSTS=travaux.commune.example
TRAVAUX_TEST_ORGANIZATION_SELF_JOIN=false

# IdP reel a qualifier ; remplacer les domaines reserves et choisir sa politique.
TRAVAUX_OIDC_EGRESS_APPROVED=false
TRAVAUX_OIDC_ISSUER=https://identite.commune.example/realms/collectivite
TRAVAUX_OIDC_CLIENT_ID=travaux-prive
TRAVAUX_OIDC_CLIENT_SECRET=
TRAVAUX_OIDC_ALLOWED_HOSTS=identite.commune.example
TRAVAUX_OIDC_PRIVATE_HOSTS=
# Valeur uniquement pour le flux Keycloak mot de passe + TOTP documente.
TRAVAUX_OIDC_REQUIRED_AMR=pwd,otp
TRAVAUX_OIDC_REQUIRED_ACR=
TRAVAUX_OIDC_SIGNUP_URL=https://identite.commune.example/realms/collectivite/protocol/openid-connect/registrations
# Fichier regulier 0600 Linux, hors repertoire de la base ; contenu non fourni.
# Ne pas definir simultanement SECRET_KEYS ou SECRET_KEY.
TRAVAUX_CONNECTOR_KEY_FILE=/run/secrets/travaux-prive-vault.keys

# Un seul endpoint approuve, modeles distincts, aucune bascule implicite.
# Le domaine ci-dessous est reserve : fournir l'endpoint contractuellement valide.
TRAVAUX_LLM=mistral
TRAVAUX_MISTRAL_URL=https://inference-approuvee.example/v1/chat/completions
TRAVAUX_MISTRAL_DOCUMENT_MODEL=mistral-large-4-0
TRAVAUX_MISTRAL_CHAT_MODEL=zai-glm-5-3-flash
TRAVAUX_MISTRAL_KEY=
TRAVAUX_LLM_EGRESS_APPROVED=false

# Laisser tous les connecteurs desactives jusqu'a la recette DSI.
# Pour Microsoft : login.microsoftonline.com,graph.microsoft.com.
# Pour Google : accounts.google.com,oauth2.googleapis.com,gmail.googleapis.com.
# Ne declarer que les hotes effectivement utilises, sans wildcard.
TRAVAUX_CONNECTOR_EGRESS_APPROVED=false
TRAVAUX_CONNECTOR_ALLOWED_HOSTS=
TRAVAUX_CONNECTOR_PRIVATE_HOSTS=
TRAVAUX_CONNECTOR_ALLOWED_PORTS=443

# Microsoft 365 : application web confidentielle dans un tenant GUID explicite.
TRAVAUX_MICROSOFT_OAUTH_CLIENT_ID=
TRAVAUX_MICROSOFT_OAUTH_CLIENT_SECRET=
TRAVAUX_MICROSOFT_OAUTH_TENANT_ID=
TRAVAUX_MICROSOFT_OAUTH_ALLOWED_DOMAINS=

# Alternative Google Workspace ; ne pas activer les deux par habitude.
TRAVAUX_GOOGLE_OAUTH_CLIENT_ID=
TRAVAUX_GOOGLE_OAUTH_CLIENT_SECRET=
TRAVAUX_GOOGLE_OAUTH_ALLOWED_DOMAINS=
